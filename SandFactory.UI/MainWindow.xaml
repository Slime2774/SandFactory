<Window x:Class="SandFactory.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SandFactory — Симулятор (Этап 1)" Height="400" Width="600">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="▶ Старт" Command="{Binding StartCommand}" Width="100" Margin="0,0,10,0" Padding="5"/>
            <Button Content="⏹ Стоп" Command="{Binding StopCommand}" Width="100" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Мощность конвейера:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Slider Value="{Binding ConveyorPower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Minimum="0" Maximum="100" Width="300" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ConveyorPower, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="10,0,0,0" Width="40"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="{Binding StatusText}" FontStyle="Italic" Foreground="Gray" Margin="0,0,0,5"/>
            <TextBlock>
                <Run Text="Объем в контейнере: "/>
                <Run Text="{Binding ContainerVolume, StringFormat={}{0:F1}}" FontWeight="Bold"/>
            </TextBlock>
            <TextBlock>
                <Run Text="Монеты: "/>
                <Run Text="{Binding Money}" FontWeight="Bold" Foreground="Green"/>
            </TextBlock>
        </StackPanel>

        <ProgressBar Grid.Row="3" Height="30"
                     Value="{Binding ContainerVolume}"
                     Maximum="100"
                     VerticalAlignment="Top"/>
    </Grid>
</Window>