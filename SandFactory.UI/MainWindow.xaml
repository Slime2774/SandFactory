<Window x:Class="SandFactory.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SandFactory.UI"
        Title="SandFactory — Симулятор (Этап 3)" Height="600" Width="850">

    <!-- Регистрируем наш конвертер, чтобы XAML его видел -->
    <Window.Resources>
        <local:PercentToGridLengthConverter x:Key="PercentToGridLengthConverter" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА: ИГРА -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="▶ Старт" Command="{Binding StartCommand}" Width="100" Margin="0,0,10,0" Padding="5"/>
                <Button Content="⏹ Стоп" Command="{Binding StopCommand}" Width="100" Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Мощность конвейера:" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding ConveyorPower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="0" Maximum="{Binding MaxPower, Mode=OneWay}" Width="300" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConveyorPower, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding MaxPower, StringFormat=(Лимит: {0}%)}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="{Binding StatusText}" FontStyle="Italic" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBlock>
                    <Run Text="Объем в контейнере: "/>
                    <Run Text="{Binding ContainerVolume, StringFormat={}{0:F1}}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Монеты: "/>
                    <Run Text="{Binding Money}" FontWeight="Bold" Foreground="Green" FontSize="16"/>
                </TextBlock>
            </StackPanel>

            <!-- КОНТЕЙНЕР (Кастомный бар) -->
            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <TextBlock Text="Заполненность контейнера:" Margin="0,0,0,5"/>
                <Border Height="30" Background="#EEE" BorderBrush="Gray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding ContainerFillPercentage, Converter={StaticResource PercentToGridLengthConverter}}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="Orange" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ТРАНСПОРТЕРЫ (Кастомные бары) -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="Транспортеры (нагрузка):" Margin="0,0,0,5"/>
                <ItemsControl ItemsSource="{Binding TransporterLoads}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <Border Height="20" Background="#EEE" BorderBrush="Gray" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Path=., Converter={StaticResource PercentToGridLengthConverter}}"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="DodgerBlue" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Path=., StringFormat={}{0:F0}%}" HorizontalAlignment="Center" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- ПРАВАЯ КОЛОНКА: МАГАЗИН И ЛОГИ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Магазин / Прокачка" Margin="0,0,0,10" Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding ConveyorLevel, StringFormat=Уровень конвейера: {0}}" FontWeight="Bold"/>
                    <Button Content="{Binding ConveyorUpgradeCost, StringFormat=Улучшить конвейер ({0} монет)}" 
                            Command="{Binding UpgradeConveyorCommand}" Margin="0,5,0,15" Padding="5"/>

                    <TextBlock Text="{Binding TransporterLevel, StringFormat=Уровень транспортеров: {0}}" FontWeight="Bold"/>
                    <Button Content="{Binding TransporterUpgradeCost, StringFormat=Улучшить транспортеры ({0} монет)}" 
                            Command="{Binding UpgradeTransportersCommand}" Margin="0,5,0,0" Padding="5"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Лог событий" Padding="5">
                <ListBox ItemsSource="{Binding Logs}" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </Grid>
</Window>